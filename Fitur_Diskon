            "Masukkan jumlah lahan: 1000\n",
            "Masukkan hasil panen per lahan (kg): 20\n",
            "Masukkan persentase diskon (%): 15\n",
            "Total hasil panen: 20000.0 kg\n",
            "Total setelah diskon: 17000.0 kg\n"
          ]
        }
      ],
      "source": [
        "def hitung_total_panen():\n",
        "    jumlah_lahan = int(input(\"Masukkan jumlah lahan: \"))\n",
        "    hasil_per_lahan = float(input(\"Masukkan hasil panen per lahan (kg): \"))\n",
        "\n",
        "    total = jumlah_lahan * hasil_per_lahan\n",
        "    return total\n",
        "\n",
        "\n",
        "def hitung_diskon(total, persen_diskon):\n",
        "    diskon = total * persen_diskon / 100\n",
        "    total_setelah_diskon = total - diskon\n",
        "    return total_setelah_diskon\n",
        "\n",
        "\n",
        "# Menghitung total hasil panen\n",
        "total = hitung_total_panen()\n",
        "\n",
        "# Menghitung diskon\n",
        "persen_diskon = float(input(\"Masukkan persentase diskon (%): \"))\n",
        "\n",
        "total_akhir = hitung_diskon(total, persen_diskon)\n",
        "\n",
        "print(f\"Total hasil panen: {total} kg\")\n",
        "print(f\"Total setelah diskon: {total_akhir} kg\")"
      ]
    }
